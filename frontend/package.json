{
  "name": "mol-card-gen-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy:rdkit-assets": "mkdir -p public/rdkit && cp node_modules/@rdkit/rdkit/dist/RDKit_minimal.js node_modules/@rdkit/rdkit/dist/RDKit_minimal.wasm public/rdkit/",
    "prebuild": "npm run copy:rdkit-assets",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "9.3.4",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "14.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "22.1.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vitest": "0.34.6"
  }
}
